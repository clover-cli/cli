{
  "name": "@clover-cli/cli",
  "version": "1.1.2",
  "description": "improving the cloud ecosystem",
  "homepage": "https://github.com/clover-cli/cli#readme",
  "bugs": {
    "url": "https://github.com/clover-cli/cli/issues"
  },
  "bin": {
    "clover": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clover-cli/cli.git"
  },
  "license": "MIT",
  "author": "andresdanielmtz",
  "module": "CommonJS",
  "moduleResolution": "Node10",
  "main": "dist/index.js",
  "files": [
    "dist",
    "man"
  ],
  "man": [
    "./docs/man/clover.1"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare": "npm run build",
    "test": "vitest run",
    "dev": "tsc --watch",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev:run": "npm run build && npm run start",
    "test:watch": "vitest",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1140.0",
    "@aws-sdk/client-ec2": "^3.1140.0",
    "@aws-sdk/client-lambda": "^3.1140.0",
    "@aws-sdk/client-rds": "^3.1140.0",
    "@aws-sdk/client-resource-groups-tagging-api": "^3.1140.0",
    "@aws-sdk/client-s3": "^3.1140.0",
    "@aws-sdk/client-sts": "^3.1139.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/yargs": "^17.0.35",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "keywords": ["clover", "cloud", "aws"]
}
